# Template for frontend/.env.ios (gitignored, not committed).
# Build-time env for the Capacitor iOS app — see docs/ARCHITECTURE.md §3.6.
# These are baked into the static export at build time; there is no server
# at runtime on-device, so every value must be real before `npm run ios:sync`.

NEXT_PUBLIC_API_URL=https://your-subdomain.duckdns.org
# Must match API_SECRET in the droplet's /opt/lifeos/.env.
NEXT_PUBLIC_API_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

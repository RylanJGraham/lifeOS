# ==========================================
# Life-OS Environment Variables
# ==========================================

# 1. OpenRouter (API Key for access to Claude/GPT-4o)
OPENROUTER_API_KEY=sk-or-v1-...

# 2. Supabase Configuration (PostgreSQL + pgvector cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# 3. Notifications: push (Expo) + the in-app Inbox. Until a mobile build can
# receive push, notify() falls back to OUTBOUND-ONLY Telegram when both of these
# are set (it stops using Telegram automatically once a device accepts push).
# Inbound Telegram chat is retired: the /webhook route is only mounted with
# TELEGRAM_ENABLED=true.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_ENABLED=true

# 3b. Public domain of the backend (VPS production).
PUBLIC_DOMAIN=your-subdomain.duckdns.org

# 4. Ngrok Tunnel (local development only — not needed on the VPS)
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# 5. Tailscale (Optional: if auth key is used for unattended install)
TAILSCALE_AUTH_KEY=tskey-auth-...

# 6. Finance (PDF Ingestion)
STATEMENT_DIRECTORY=./data/statements

# 6b. Web Search APIs (used by the agent for nutrition/fact lookup)
# Provide at least one. The agent tries Brave -> Bing -> Serper -> disabled.
BRAVE_API_KEY=...
BING_SEARCH_API_KEY=...
SERPER_API_KEY=...

# 6c. EU Open Banking (optional; live fetch not yet implemented)
GOCARDLESS_SECRET_ID=...
GOCARDLESS_SECRET_KEY=...
GOCARDLESS_ACCOUNT_ID=...
SALTEDGE_APP_ID=...
SALTEDGE_SECRET=...
SALTEDGE_CUSTOMER_ID=...
PLAID_CLIENT_ID=...
PLAID_SECRET=...
PLAID_ACCESS_TOKEN=...

# 7. Finnhub (For Stock/Market Data)
FINNHUB_API_KEY=...

# 7b. Interactive Brokers Flex Query (read-only broker sync)
# Create a Flex Query in IBKR Account Management: Reports > Flex Queries.
# Generate a Flex Web Service token and copy the query ID.
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_flex_query_id

# 8. Web Search (nutrition/finance fact verification — at least one required)
# Brave Search API: https://api.search.brave.com/
BRAVE_API_KEY=...
# Bing Search API: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=...
# Serper.dev (Google search API): https://serper.dev/
SERPER_API_KEY=...

# 9. Xiaomi Mi Fitness (For Sleep and Workout Data)
XIAOMI_EMAIL=your_email@example.com
XIAOMI_PASSWORD=your_password
XIAOMI_REGION=eu

# 10. Ollama Local Endpoint (optional, local dev only — general chat prefers it
# and falls back to OpenRouter when unreachable; not needed on the VPS)
OLLAMA_HOST=http://localhost:11434

# 11. Supabase Auth (For Next.js Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# FastAPI Backend (For Next.js Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 12. Redis Endpoint (For LangGraph State/Memory Cache)
REDIS_URL=redis://localhost:6379

# 13. LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key


# 14. API auth. Clients (mobile app, dashboard) authenticate with their Supabase
# session token — no secret ships in a client bundle. API_SECRET is only for
# non-interactive callers (iOS Shortcut, scripts) that send `X-API-Key`.
# Leave it unset to disable the API-key path entirely (auth fails closed).
API_SECRET=generate-a-long-random-string

# 14b. Your Supabase login's user id (Supabase -> Authentication -> Users). Needed
# when your existing data is stored under the user_profiles id rather than your
# login id (the case for this deployment): that one login is mapped to the data.
OWNER_AUTH_USER_ID=00000000-0000-0000-0000-000000000000

# 15. Browser origins allowed to call the API (comma separated). Native mobile
# does not use CORS. Default: http://localhost:3000,http://localhost:8081
CORS_ORIGINS=https://your-dashboard.vercel.app,http://localhost:3000

# 15b. Encrypts stored calendar links (Fernet key; never leaves the server). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, linking an external calendar is refused (fails closed). If the key is lost,
# linked calendars must be re-added.
CALENDAR_ENCRYPTION_KEY=

# 16. IANA timezone used to interpret calendar phrases like "thursday 3pm".
LIFEOS_TIMEZONE=Europe/Dublin

# 17. Postgres connection string for scripts/migrate.py (Supabase -> Connect ->
# Session pooler). Only needed on the machine where you apply migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

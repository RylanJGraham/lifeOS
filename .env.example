# ==========================================
# Life-OS Environment Variables
# ==========================================

# 1. OpenRouter (API Key for access to Claude/GPT-4o)
OPENROUTER_API_KEY=sk-or-v1-...

# 2. Supabase Configuration (PostgreSQL + pgvector cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# 3. Telegram Bot Configuration (From BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_WEBHOOK_URL=https://telegram-webhook.your-domain.com

# 4. Ngrok Tunnel (For setting up the secure tunnel to localhost:8000)
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# 5. Tailscale (Optional: if auth key is used for unattended install)
TAILSCALE_AUTH_KEY=tskey-auth-...

# 6. Finance (PDF Ingestion)
STATEMENT_DIRECTORY=./data/statements

# 6b. Web Search APIs (used by the agent for nutrition/fact lookup)
# Provide at least one. The agent tries Brave -> Bing -> Serper -> disabled.
BRAVE_API_KEY=...
BING_SEARCH_API_KEY=...
SERPER_API_KEY=...

# 6c. EU Open Banking (optional; live fetch not yet implemented)
GOCARDLESS_SECRET_ID=...
GOCARDLESS_SECRET_KEY=...
GOCARDLESS_ACCOUNT_ID=...
SALTEDGE_APP_ID=...
SALTEDGE_SECRET=...
SALTEDGE_CUSTOMER_ID=...
PLAID_CLIENT_ID=...
PLAID_SECRET=...
PLAID_ACCESS_TOKEN=...

# 7. Finnhub (For Stock/Market Data)
FINNHUB_API_KEY=...

# 7b. Interactive Brokers Flex Query (read-only broker sync)
# Create a Flex Query in IBKR Account Management: Reports > Flex Queries.
# Generate a Flex Web Service token and copy the query ID.
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_flex_query_id

# 8. Web Search (nutrition/finance fact verification — at least one required)
# Brave Search API: https://api.search.brave.com/
BRAVE_API_KEY=...
# Bing Search API: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=...
# Serper.dev (Google search API): https://serper.dev/
SERPER_API_KEY=...

# 9. Xiaomi Mi Fitness (For Sleep and Workout Data)
XIAOMI_EMAIL=your_email@example.com
XIAOMI_PASSWORD=your_password
XIAOMI_REGION=eu

# 10. Ollama Local Endpoint (Default should be localhost:11434)
OLLAMA_HOST=http://localhost:11434

# 11. Supabase Auth (For Next.js Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# FastAPI Backend (For Next.js Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 12. Redis Endpoint (For LangGraph State/Memory Cache)
REDIS_URL=redis://localhost:6379

# 13. LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key


API_SECRET=change-me
